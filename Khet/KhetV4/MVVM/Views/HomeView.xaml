<UserControl
    x:Class="KhetV4.MVVM.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:KhetV4.MVVM.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="#292824">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="LaserRotation"
                            Storyboard.TargetProperty="Angle"
                            From="0"
                            To="360"
                            Duration="0:0:4"
                            RepeatBehavior="Forever" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Canvas
            Width="400"
            Height="400"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Image
                Canvas.Left="176"
                Canvas.Top="10"
                Width="48"
                Height="48"
                Source="../../Assets/Pieces/DjedSilver.png" />

            <Image
                Canvas.Left="342"
                Canvas.Top="176"
                Width="48"
                Height="48"
                Source="../../Assets/Pieces/DjedSilver.png" />

            <Image
                Canvas.Left="176"
                Canvas.Top="342"
                Width="48"
                Height="48"
                Source="../../Assets/Pieces/DjedSilver.png" />

            <Image
                Canvas.Left="10"
                Canvas.Top="176"
                Width="48"
                Height="48"
                Source="../../Assets/Pieces/DjedSilver.png" />

            <Line
                X1="200"
                Y1="200"
                X2="200"
                Y2="30"
                Stroke="Red"
                StrokeThickness="3">
                <Line.RenderTransform>
                    <RotateTransform x:Name="LaserRotation" CenterX="200" CenterY="200" />
                </Line.RenderTransform>
            </Line>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Row="5"
                Grid.Column="3"
                Background="#292824"
                Click="{s:Action NavigateToLocalGame}"
                Content="Play Game"
                Foreground="SandyBrown" />


            <Button
                Grid.Row="5"
                Grid.Column="5"
                Background="#292824"
                Click="{s:Action NavigateToLanGame}"
                Content="LAN Game"
                Foreground="SandyBrown" />


            <Button
                Grid.Row="5"
                Grid.Column="1"
                Background="#292824"
                Click="{s:Action NavigateToFreePlay}"
                Content="Free Play"
                Foreground="SandyBrown" />


        </Grid>
    </Grid>
</UserControl>
